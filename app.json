{
  "expo": {
    "name": "Meditation Habit Tracker",
    "slug": "meditation-tracker",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "automatic",
    "scheme": "com.meditationtracker.app",
    "android": {
      "package": "com.meditationtracker.app",
      "adaptiveIcon": {
        "foregroundImage": "./assets/adaptive-icon.png",
        "backgroundColor": "#B45309"
      },
      "permissions": [
        "android.permission.VIBRATE",
        "android.permission.RECEIVE_BOOT_COMPLETED",
        "android.permission.WAKE_LOCK",
        "android.permission.SCHEDULE_EXACT_ALARM"
      ],
      "versionCode": 1
    },
    "platforms": [
      "android"
    ],
    "plugins": [
      [
        "expo-notifications",
        {
          "icon": "./assets/notification-icon.png",
          "color": "#B45309",
          "sounds": [
            "./assets/meditation_chime.wav"
          ]
        }
      ],
      "expo-web-browser",
      "expo-secure-store",
      [
        "expo-splash-screen",
        {
          "image": "./assets/splash-icon.png",
          "resizeMode": "contain",
          "backgroundColor": "#B45309"
        }
      ],
      "@react-native-community/datetimepicker",
      "expo-font",
      "expo-status-bar"
    ],
    "extra": {
      "eas": {
        "projectId": "88b23d78-a8b8-416d-9b80-da55fa762536"
      }
    }
  }
}
